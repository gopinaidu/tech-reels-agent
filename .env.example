# ReelAgent local development environment template
# Copy this file to .env and populate values locally.
# Never commit .env or real credentials/tokens.

# -----------------------------
# Application
# -----------------------------
APP_ENV=development
LOG_LEVEL=INFO
MAX_REVISION_CYCLES=2

# -----------------------------
# Database
# -----------------------------
DATABASE_URL=

# -----------------------------
# LLM providers
# -----------------------------
# Default development provider uses Gemini free-tier eligible models.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
TOPIC_INTELLIGENCE_MODEL=gemini-3.1-flash-lite
VERIFICATION_MODEL=gemini-3.1-flash-lite
SCRIPT_WRITER_MODEL=gemini-3.1-flash-lite
# Optional alternative provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------
# Verification search
# -----------------------------
# Default development search provider uses Serper's free query allocation.
VERIFICATION_SEARCH_PROVIDER=serper
VERIFICATION_SEARCH_LIMIT=5
SERPER_API_KEY=
# Optional alternative provider.
BRAVE_SEARCH_API_KEY=

# -----------------------------
# Narration / TTS
# -----------------------------
TTS_PROVIDER=
TTS_API_KEY=

# -----------------------------
# YouTube publishing
# -----------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# -----------------------------
# Optional storage / rendering
# -----------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
